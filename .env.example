# Public frontend settings. Copy into apps/web/.env when the web track exists.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional Playwright base URL; start web and API before running e2e.
E2E_BASE_URL=http://127.0.0.1:5173

# AI Provider settings
# AI_PROVIDER=stub (default: openai with a key, otherwise stub; also supports http)
# OPENAI_API_KEY= (server only; never use a VITE_ prefix)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# AI_HTTP_URL=http://127.0.0.1:8000/ask
# AI_HTTP_TOKEN=
AI_HTTP_MODEL=class9
AI_VISION_PROVIDER=none
AI_TIMEOUT_MS=12000
AI_DAILY_TOKEN_BUDGET=30000

# API-only settings are documented in apps/api/.env.example.
