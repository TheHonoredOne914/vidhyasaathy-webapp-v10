{
  "name": "@vidhyasaathy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx src/db/backup-cli.ts",
    "test": "vitest run --configLoader native --pool threads --reporter dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@google/genai": "^2.32.0",
    "@vidhyasaathy/contracts": "*",
    "@vidhyasaathy/core": "*",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.6"
  }
}
