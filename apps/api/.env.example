NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/vidhyasaathy.db
UPLOAD_DIRECTORY=./uploads
SESSION_COOKIE_NAME=vidhyasaathy_session
SESSION_TTL_SECONDS=604800
PIN_LOCKOUT_SECONDS=900
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
# Local-only open auth defaults on in development. Set false to restore normal auth.
DEMO_LOOSE_AUTH=true
# Optional. Without a key, Ask Saathy quotes matching sentences from published notes and draft jobs show "AI not configured".
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# Saathy's tutor behavior and textbook indexes are integrated from whodhruv7/Model.
# Choose one real inference provider. These are AI provider keys, never GitHub PATs.
# Gemini can also be configured by an administrator in Founder settings.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER=gemini
# Or use your Model app's OpenAI-compatible provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=your-model-id
# OPENAI_API_URL=https://your-provider.example/v1/chat/completions
# Required for roster imports and printable claim codes. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CLAIM_CODE_ENCRYPTION_KEY=
