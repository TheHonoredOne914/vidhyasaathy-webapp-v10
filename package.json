{
  "name": "vidhyasaathy-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/preview.mjs",
    "dev": "concurrently --kill-others --names web,api \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "demo": "node scripts/demo.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --workspace vitest.workspace.ts --configLoader native --pool threads --reporter dot",
    "test:flows": "node --test --test-isolation=none apps/api/test/flow.smoke.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "deps:check": "depcheck --config .depcheckrc.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^24.0.0",
    "@vidhyasaathy/contracts": "*",
    "@vidhyasaathy/core": "*",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.1.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true
  }
}
